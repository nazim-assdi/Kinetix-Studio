# Optional server-wide Gemini key (used for all AI users when present).
# If omitted, users can provide their own key in the AI panel for their browser session.
# Never commit a real key to Git.
# GEMINI_API_KEY=

# Optional shared access key for protecting the AI editing endpoint on public deployments.
# When set, the browser will ask AI users for this key once per session.
# KINETIX_AI_ACCESS_KEY=
